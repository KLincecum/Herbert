<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <AssemblyName>herbert-managed-decompiler</AssemblyName><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <PublishAot>true</PublishAot><InvariantGlobalization>true</InvariantGlobalization><AllowUnsafeBlocks>true</AllowUnsafeBlocks><DisableRuntimeMarshalling>true</DisableRuntimeMarshalling>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile><JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <StripSymbols>true</StripSymbols><CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
  </PropertyGroup>
  <ItemGroup><PackageReference Include="ICSharpCode.Decompiler" Version="11.1.0.9782" /></ItemGroup>
  <!-- Record only the PDB file name in the native image, not the local build path. -->
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))"><LinkerArg Include="/PDBALTPATH:%_PDB%" /></ItemGroup>
</Project>
